PORT=5000
MONGO_URI=mongodb://localhost:27017/kavach
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NODE_ENV=development
HUGGING_FACE_TOKEN=your_optional_huggingface_token

# MSG91 OTP Service (optional)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_OTP_EXPIRY=5
MSG91_OTP_LENGTH=6

# Fast2SMS OTP Service
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=

# OTP provider selection: msg91 | fast2sms
OTP_PROVIDER=msg91

OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_SMS_TEMPLATE=Your KAVACH OTP is {OTP}. Valid for {EXPIRY_MIN} minutes. Do not share it with anyone.
