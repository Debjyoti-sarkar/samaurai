PORT=5000
MONGO_URI=mongodb://localhost:27017/kavach
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NODE_ENV=development
HUGGING_FACE_TOKEN=your_optional_huggingface_token

# Fast2SMS OTP Service
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=

# OTP provider selection
OTP_PROVIDER=fast2sms

OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_SMS_TEMPLATE=Your KAVACH OTP is {OTP}. Valid for {EXPIRY_MIN} minutes. Do not share it with anyone.

# Aadhaar KYC API (Surepass)
AADHAAR_API_KEY=your_aadhaar_api_key
AADHAAR_API_SECRET=your_aadhaar_api_secret
AADHAAR_BEARER_TOKEN=your_aadhaar_bearer_token
AADHAAR_API_BASE_URL=https://kyc-api.surepass.io/api/v1
